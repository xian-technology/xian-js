{
  "name": "@xian-tech/types",
  "version": "0.3.3",
  "description": "Shared TypeScript contracts and dependency-free runtime primitives for Xian",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian-technology/xian-js.git",
    "directory": "packages/types"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/nonce-reservation": {
      "types": "./dist/internal/nonce-reservation.d.ts",
      "import": "./dist/internal/nonce-reservation.js",
      "default": "./dist/internal/nonce-reservation.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
